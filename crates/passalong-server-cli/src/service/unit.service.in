# systemd system unit for `passalong-server serve`.
# Written by `passalong-server service install`.
#
# That command writes this unit, creates the `passalong-server` user and its
# directories, enables the unit, and starts it; `service remove` takes the
# unit away again and nothing else. A test keeps the copy in the repository,
# docs/service/passalong-server.service, identical to what it writes.
# Logs:
#   journalctl -u passalong-server.service -f
# Commands run as the service's user, never as root:
#   sudo -u passalong-server passalong-server key list
#
# Unlike the client's unit this is a system unit: a server has no desktop
# session and must run before anyone logs in.

[Unit]
Description=passalong-server: clipboard and file sharing between your devices
Documentation=https://github.com/joelee/passalong-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{binary}} serve
User=passalong-server
Group=passalong-server
# /var/lib/passalong-server and /etc/passalong-server, owned and private.
StateDirectory=passalong-server
StateDirectoryMode=0700
ConfigurationDirectory=passalong-server
ConfigurationDirectoryMode=0700
Restart=on-failure
RestartSec=5
# `serve` lets requests in flight finish for up to 30 seconds.
TimeoutStopSec=45
# error, warning, info, verbose, or debug
Environment=PASSALONG_SERVER_LOG_LEVEL=info

# Hardening: the server needs the network and its state directory only.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
# Listening below port 1024 would need: AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
